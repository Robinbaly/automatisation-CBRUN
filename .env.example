# Personal Access Token Airtable (scopes nécessaires : data.records:read, data.records:write, schema.bases:read)
# À créer sur https://airtable.com/create/tokens, avec accès à la base "CBRUN - ERP" uniquement.
# Ne jamais commettre la vraie valeur : à renseigner uniquement dans les variables d'environnement Vercel
# (ou dans un fichier .env local non commité).
AIRTABLE_TOKEN=

# Optionnel : ID de la base Airtable si tu veux pointer vers une autre base que "CBRUN - ERP".
# AIRTABLE_BASE_ID=appxDtzVHHtBR8qnD

# Mot de passe unique pour accéder à l'application (écran de connexion).
APP_PASSWORD=
